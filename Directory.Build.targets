<Project>
  <PropertyGroup>
    <LuaRefOut Condition="'$(LuaRefOut)' == ''">$(MSBuildThisFileDirectory)Lua\Imp.lua</LuaRefOut>
    <LuaRefProj>$(MSBuildThisFileDirectory)Tools\LuaRef\LuaRef.csproj</LuaRefProj>
    <_EngineDll>$(MSBuildThisFileDirectory)Engine\bin\$(Configuration)\net10.0\Engine.dll</_EngineDll>
  </PropertyGroup>

  <Target Name="GenerateLuaRef"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' AND ('$(MSBuildProjectName)' == 'Engine' OR '$(MSBuildProjectName)' == 'Game' OR '$(MSBuildProjectName)' == 'Editor')">
    <MSBuild Projects="$(LuaRefProj)" Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <PropertyGroup>
      <_LuaRefDll>$(MSBuildThisFileDirectory)Tools\LuaRef\bin\$(Configuration)\net10.0\LuaRef.dll</_LuaRefDll>
      <_LuaRefArgs>"$(LuaRefOut)" "$(_EngineDll)"</_LuaRefArgs>
      <_LuaRefArgs Condition="'$(TargetPath)' != '' AND '$(MSBuildProjectName)' != 'Engine'">"$(LuaRefOut)" "$(_EngineDll)" "$(TargetPath)"</_LuaRefArgs>
    </PropertyGroup>
    <Exec Command="dotnet exec &quot;$(_LuaRefDll)&quot; $(_LuaRefArgs)" />
  </Target>
</Project>
