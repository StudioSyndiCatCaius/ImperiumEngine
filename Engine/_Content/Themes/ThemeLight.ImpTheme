{
  "_class": "ImpUITheme",
  "vars": {
    "display_name": "Light",

    "font_file": "{engine}/Fonts/FNT_Arial.ImpAsset",
    "font_size": 16,
    "font_spacing": 1.0,

    "col_background": "#EDEDF0",
    "col_panel": "#F7F7FA",
    "col_panel_alt": "#FFFFFF",
    "col_accent": "#3B7DDD",
    "col_hover": "#DCDCE4",
    "col_pressed": "#C6C6D0",
    "col_disabled": "#E4E4E8",
    "col_text": "#1E1E24",
    "col_text_dim": "#6E6E7A",
    "col_line": "#C8C8D2",

    "menubar_height": 28,
    "tab_height": 30,
    "item_height": 26,
    "padding": 8,
    "scrollbar_width": 12,
    "menu_min_width": 180
  }
}
